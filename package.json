{
  "name": "brightspace-typescript-quiz",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/prepare-assets.mjs && vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "npm run typecheck && node scripts/prepare-assets.mjs && vite build --mode components && vite build && node scripts/verify-build.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "check": "npm run typecheck && npm test && npm run build",
    "test:browser": "playwright test",
    "format": "prettier --write src tests/*.ts tests/browser/*.ts tests/dev/*.ts *.ts scripts/*.mjs README.md docs/*.md",
    "test:dev": "playwright test --config playwright.dev.config.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@fontsource/lato": "^5.3.0",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@brightspace-ui/core": "^3.340.0"
  }
}
